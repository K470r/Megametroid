       {
          /* 16-bit hardware */
@@ -4014,3 +4018,14 @@ void retro_run(void)
 }
 
 #undef  CHUNKSIZE
+
+/* MegaMetroid: arnés de pruebas (retrorun "regs"): registros del 68000 */
+RETRO_API unsigned mm_m68k_reg(int r)
+{
+   return m68k_get_reg((m68k_register_t)r);
+}
+/* MegaMetroid: CRAM del VDP (formato interno del núcleo, 64 colores x 2 bytes) */
+RETRO_API void *mm_cram(void) { return cram; }
+/* MegaMetroid: VSRAM y registros del VDP (prueba de regresión por estado del VDP) */
+RETRO_API void *mm_vsram(void) { return vsram; }
+RETRO_API void *mm_vdpreg(void) { return reg; }
